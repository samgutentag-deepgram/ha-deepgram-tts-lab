# Copy to .env, fill in, and never commit it. .env is gitignored; this file is not.
#
#   cp .env.sample .env
#   $EDITOR .env
#
# The shell scripts source this file on their own. The Python scripts read the real
# environment, so export it into your shell before running them:
#
#   set -a && source .env && set +a
#
# Then any of these work:
#
#   python3 scripts/live_check.py
#   python3 scripts/measure_first_frame.py --runs 20 --label "Pi 5, NVMe, wired"
#   ./scripts/deploy.sh
#   ./scripts/tail_ha_log.sh


# =============================================================================
# Deepgram
# =============================================================================

# From https://console.deepgram.com. Used for synthesis only; both voice catalogs
# are public and need no key, which is why the voice picker works before the key
# is validated.
#
# This one value unblocks three things: the chapter 2 authenticated round trip,
# the open question about whether `speed` is range checked server side, and the
# first frame latency measurement that the streaming work is gated on.
DEEPGRAM_API_KEY=


# =============================================================================
# Deploying to the Home Assistant instance
# =============================================================================

# LEAVE THIS EMPTY FOR NOW. Probed 2026-09-15: homeassistant.local is 192.168.1.197,
# port 8123 answers, and ports 22, 22222, 445 and 139 are all closed. There is no SSH
# app and no Samba app on the instance, so rsync has nowhere to connect and deploy.sh
# will refuse rather than guess.
#
# Until one of those exists, the copy path is:
#
#   ./scripts/serve_bundle.sh
#
# which tars the integration, serves it on the LAN for one download, and prints the
# single line to paste into the Studio Code Server terminal. Verified end to end: all
# 12 files arrive byte-identical.
#
# Fill this in as `rsync` the moment the Advanced SSH and Web Terminal app is
# installed. Everything below is already correct for that, so it becomes a one word
# change.
#
#   rsync  rsync over ssh to a remote instance. What you want for iterating.
#   local  plain copy into a directory on this machine, for a Container install whose
#          /config is a bind mount from this host. Not your setup.
HA_DEPLOY_TRANSPORT=

# Your instance. Home Assistant OS on a Raspberry Pi with an NVMe drive.
# Resolves to 192.168.1.197. Use the hostname; the IP can move on a DHCP lease.
HA_DEPLOY_SSH_HOST=homeassistant.local

# The Advanced SSH and Web Terminal app listens on 22 as root.
# Port 22222 is the Home Assistant OS *host* shell, which is a different shell
# with a different filesystem layout. Use 22.
HA_DEPLOY_SSH_USER=root
HA_DEPLOY_SSH_PORT=22

# Optional. Leave empty to use your default ssh identity and agent.
HA_DEPLOY_SSH_KEY=

# Where Home Assistant keeps configuration.yaml, as seen from inside the SSH app.
# /config is right for the Advanced SSH and Web Terminal app on HA OS. If you end
# up on the host shell on 22222 instead, it is
# /mnt/data/supervisor/homeassistant.
HA_DEPLOY_CONFIG_DIR=/config


# =============================================================================
# Restarting after a deploy
# =============================================================================

# Confirmed responding: HTTP 200 on / and 401 on /api/, which means the REST API is
# live and only wants a token.
HA_DEPLOY_URL=http://homeassistant.local:8123

# Long lived access token. Home Assistant sidebar, click your name at the bottom,
# Security tab, scroll to "Long-lived access tokens", Create Token.
# Leave empty and deploy.sh still copies the files, then tells you to restart by
# hand instead of failing.
HA_DEPLOY_TOKEN=

# restart  POST homeassistant.restart. The only thing that picks up changed Python.
# reload   Re-runs setup against the module Python ALREADY imported, so it does not
#          see an edited .py. Useful for a changed option or a replaced key.
# none     Copy only.
HA_DEPLOY_RESTART=restart

# Only needed when HA_DEPLOY_RESTART=reload.
HA_DEPLOY_ENTRY_ID=


# =============================================================================
# Reading the log after a deploy
# =============================================================================

# ssh  tail the log file over ssh. Faster, and survives a restart.
# api  poll /api/error_log. Needs HA_DEPLOY_TOKEN.
# Set this to `api` for now. The `ssh` source needs port 22, which is closed.
HA_DEPLOY_LOG_SOURCE=api
HA_DEPLOY_LOG_FILE=/config/home-assistant.log
HA_DEPLOY_LOG_FILTER=deepgram
HA_DEPLOY_LOG_FOLLOW=1
HA_DEPLOY_LOG_LINES=200
HA_DEPLOY_LOG_INTERVAL=2


# =============================================================================
# Safety
# =============================================================================

# 1 prints the plan and an rsync dry run without writing anything. Worth using
# the first time, to see exactly which paths it would touch.
HA_DEPLOY_DRY_RUN=0

# DANGER. 1 passes --delete to rsync, which removes files on the instance that are
# absent here. A wrong HA_DEPLOY_CONFIG_DIR plus this deletes another integration
# and there is no undo on the far side. Only turn it on when a renamed module is
# actually stranding a stale .py that Home Assistant keeps importing.
HA_DEPLOY_ALLOW_DELETE=0
